# Generated output — rebuilt every run, and the day files under dist/data are
# republished to the live site rather than versioned here.
dist/

# Python
__pycache__/
*.pyc
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Secrets. OPENROUTER_API_KEY and CLOUDFLARE_API_TOKEN belong in the shell, in
